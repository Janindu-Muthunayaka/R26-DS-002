# Copy to `.env` at the REPOSITORY ROOT and fill in. `.env` is gitignored.
#
#   copy services\.env.example .env
#
# NEVER commit the filled-in file, paste it into a chat, or screenshot it.
# git does not forget a committed blob — a leaked key must be ROTATED at
# platform.openai.com, not deleted.

OPENAI_API_KEY=sk-...

# Which models to use. There is no safe default to guess here — run
#   python tools\check_llm.py
# to list what this key can actually reach, then set these.
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: an OpenAI-compatible endpoint (Azure, a local gateway, a proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_TIMEOUT=60
